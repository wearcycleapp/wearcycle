  "components": [
    {
      "name": "Main action (Wear this)",
      "kind": "button",
      "refersTo": "button-cta",
      "description": "The one coral action per screen.",
      "html": "<button class=\"ds-btn-cta\">Wear this</button>",
      "css": ".ds-btn-cta{background:var(--coral,#ff7a59);color:var(--coral-ink,#1b2433);border:1px solid var(--coral,#ff7a59);height:48px;padding:0 20px;border-radius:12px;font:700 15px Figtree,system-ui,sans-serif}.ds-btn-cta:focus-visible{outline:2px solid var(--accent,#1b2433);outline-offset:2px}@media (hover:hover) and (pointer:fine){.ds-btn-cta:hover{filter:brightness(.96)}}.ds-btn-cta:active{transform:scale(.98)}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink button for confirming actions in sheets.",
      "html": "<button class=\"ds-btn-primary\">Save</button>",
      "css": ".ds-btn-primary{background:var(--accent,#1b2433);color:var(--accent-ink,#fff);border:1px solid var(--accent,#1b2433);padding:10px 14px;border-radius:8px;font:600 14px Figtree,system-ui,sans-serif;min-height:44px}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#1b2433);outline-offset:2px}"
    },
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default quiet button.",
      "html": "<button class=\"ds-btn\">Swap for another</button>",
      "css": ".ds-btn{background:var(--raised,#fff);color:var(--ink,#1b2433);border:1px solid var(--line,#e2ded8);padding:10px 14px;border-radius:8px;font:600 14px Figtree,system-ui,sans-serif;min-height:44px}.ds-btn:focus-visible{outline:2px solid var(--accent,#1b2433);outline-offset:2px}@media (hover:hover) and (pointer:fine){.ds-btn:hover{background:var(--surface,#fbfaf8)}}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Toggle chip; selected is an ink fill with aria-pressed.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Work</button><button class=\"ds-chip\" aria-pressed=\"false\">Going out</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{min-height:44px;padding:0 16px;border-radius:999px;border:1px solid var(--line,#e2ded8);background:var(--surface,#fbfaf8);color:var(--muted,#5b6270);font:600 14px Figtree,system-ui,sans-serif}.ds-chip[aria-pressed=\"true\"]{background:var(--ink,#1b2433);color:var(--bg,#f6f4f1);border-color:var(--ink,#1b2433)}.ds-chip:focus-visible{outline:2px solid var(--accent,#1b2433);outline-offset:2px}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled input used in the item editor and settings.",
      "html": "<label class=\"ds-field\"><span>Name</span><input value=\"Navy chinos\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font:600 13px Figtree,system-ui,sans-serif;color:var(--ink,#1b2433)}.ds-field input{background:var(--raised,#fff);border:1px solid var(--line,#e2ded8);border-radius:8px;padding:10px 12px;font:400 15px Figtree,system-ui,sans-serif;color:inherit}.ds-field input:focus-visible{outline:2px solid var(--accent,#1b2433);outline-offset:2px}"
    },
    {
